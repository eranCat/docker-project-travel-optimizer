# Required — get from https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# Required — get from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-key-here

# Set to your public deployment URL so the React app talks to the right backend
# Render example: https://travel-optimizer.onrender.com
# Local:          http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
